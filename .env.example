# Copy to .env (make up does this when .env is missing). Values here are for the
# local Compose stack only; cloud values live in SSM. Compose reads this file for
# ${VAR} substitution and the Makefile exports it for host-side dbt and tests.
# The Makefile includes this file as make syntax, so values must not contain
# "$" or "#" and must not be quoted.

# Warehouse: the PostGIS database that dbt and the loaders write to.
# WAREHOUSE_HOST and WAREHOUSE_PORT are how the host reaches it; Compose overrides
# them for the Dagster containers, which reach it on the internal network.
# The host port is 5433 because 5432 is often taken by another local Postgres.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433
WAREHOUSE_USER=mesh
WAREHOUSE_PASSWORD=mesh
WAREHOUSE_DB=mesh_terrain

# Dagster run, event and schedule storage. Same Postgres server, separate database,
# so a warehouse reset never loses run history and a Dagster upgrade never touches
# the warehouse.
DAGSTER_PG_DB=dagster

# Object store standing in for S3. S3_ENDPOINT_URL is the API; the console is on
# MINIO_CONSOLE_PORT. The Dagster containers get the internal endpoint from Compose.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
RAW_BUCKET=mesh-terrain-raw

# Dagster webserver host port.
DAGSTER_PORT=3000

# "console" for a developer terminal, "json" in containers (Compose sets json).
LOG_FORMAT=console

# Optional. Where the dbt project lives when it is not <repo>/dbt.
# DBT_PROJECT_DIR=

# Optional, Windows hosts whose antivirus re-signs HTTPS: a CA bundle that
# includes the scanner's root, so Python can reach PyPI and the dbt hub
# (README, "Running on Windows").
# SSL_CERT_FILE=C:/Users/you/.certs/ca-bundle.pem
# REQUESTS_CA_BUNDLE=C:/Users/you/.certs/ca-bundle.pem
